{{!
    @template tiny_bibliography/body/insert_bibliography_body

    Display a bibliography form
}}

<div class="tab-content row mt-2" id="{{id}}_tiny_bibliography_form_container">
    <div class="col-12 {{^showForm}}d-none{{/showForm}}" id="bibliography-form-container">
        <form id="bibliography-form" onsubmit="return false;">
            {{> tiny_bibliography/style_resource }}
            <div class="biblio-pannel p-2" id="main-input-fields">
                {{> tiny_bibliography/forms/field }}
            </div>
        </form>
    </div>
    <div class="col-12">
        <div class="biblio-pannel p-2 biblio-bottom-pannel mt-3 {{^showForm}}d-none{{/showForm}}" id="bibliography-ie-panel"></div>
    </div>
    <div class="col-12 {{#showForm}}d-none{{/showForm}}" id="bibliography-list-outer-modal-container">
        <div class="biblio-list-container" id="bibliography-list-modal-container">
            {{> tiny_bibliography/no_bibliography }}
        </div>
    </div>
</div>
