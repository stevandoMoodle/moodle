{{!
    @template tiny_media/bibliography_modal

    Embed media modal template.

    Example context (json):
    {

    }
}}
{{< core/modal }}

    {{$body}}
        <form class="tiny_bibliography_form" id="{{id}}_tiny_bibliography_form">
            <div role="alert" class="d-none alert alert-warning mb-1 tiny_bibliography_warning">
                <label>{{#str}} modal_warning:default_style_not_enabled, tiny_bibliography, {{defaultStyle}} {{/str}}</label>
            </div>
            <div role="progressbar" class="d-none tiny_bibliography_loader lead border rounded text-center">
                <div class="tiny_bibliography_loader_container d-flex flex-column justify-content-center">
                    <span data-region="loading-icon-container">
                        {{> core/loading }}
                    </span>
                    <div>{{#str}} preparing, tiny_bibliography {{/str}}</div>
                </div>
            </div>
            <div class="tiny_bibliography_body_template"></div>
        </form>
    {{/body}}

    {{$footer}}
        <div class="tiny_bibliography_footer_template container">
            <div class="row">
                <div class="col-6"></div>
                <div class="col-6 text-end p-0">
                    <button type="button" class="btn btn-secondary" data-action="cancel">
                        {{#str}} cancel, moodle {{/str}}
                    </button>
                    {{#usedStyleNotAvailable}}
                        <button type="button" class="btn btn-primary" data-action="delete-all-bibliography">
                            {{#str}} button:delete_bibliography, tiny_bibliography {{/str}}
                        </button>
                    {{/usedStyleNotAvailable}}
                </div>
            </div>
        </div>
    {{/footer}}

{{/ core/modal }}
