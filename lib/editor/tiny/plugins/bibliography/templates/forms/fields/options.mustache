{{!
    @template tiny_accessibilitychecker/title

    Display title field
}}

{{#show}}
<div class="row fitem p-2">
    <div class="col-3 col-form-label d-flex pb-0 pe-md-0">
        <label class="d-inline word-break" for="id_bibliography_{{field}}">
            {{label}} {{#required}}*{{/required}}
        </label>
    </div>

    <div class="col-9 align-items-start felement" data-fieldtype="text">
        <select
            class="form-select w-100"
            data-type="bibliography-info-example"
            data-name="{{field}}"
            id="id_bibliography_{{field}}"
        >
            {{#options}}
                <option value="{{name}}">{{label}}</option>
            {{/options}}
        </select>
    </div>
</div>
{{/show}}
