{{!
    @template tiny_bibliography/forms/fields/author

    Display a content warning message

    Example context (json):
    {
        "warnings": [
            {
                "description": "This is a warning message",
                "nodeData": [{
                    "text": "Text of content",
                    "src": "https://example.com/image.png",
                    "nodeName": "IMG",
                    "nodeIndex": 0
                }]
            }
        ]
    }
}}

{{#show}}
<div id="full-{{field}}-holder" class="row fitem bibliography-field p-2">
    <div class="col-3 col-form-label d-flex pb-0 pe-md-0">
        <label class="d-inline word-break " for="id_bibliography_{{field}}">
            {{label}} {{#required}}*{{/required}}
        </label>
    </div>

    <div class="col-9 d-flex justify-content-between" data-fieldtype="text">
        <div class="col-8 col-form-label d-flex pb-0 pe-md-0" style="padding-left: unset;">
            <textarea
                type="text"
                class="form-control"
                id="id_bibliography_{{field}}"
                data-type="bibliography-info-example"
                data-author="true"
                data-example="{{example}}"
                data-name="{{field}}"
                placeholder="{{label}}"
                style="width: 100%;"
            >{{data}}</textarea>
        </div>
        <div class="col-4 col-form-label pb-0 pe-md-0 form-button">
            <button class="btn btn-primary" data-field="{{field}}" id="id-custom-{{field}}" data-action="custom-bibliography-author">
                <span>{{#str}} button:edit, tiny_bibliography {{/str}}</span>
            </button>
        </div>
    </div>
</div>
<div id="custom-{{field}}-holder" class="row fitem d-none p-2">
    <div class="col-3 col-form-label d-flex pb-0 pe-md-0">
        <label class="d-inline word-break">
            {{label}} {{#required}}*{{/required}}
        </label>
    </div>

    <div class="col-9 align-items-start" data-fieldtype="text">
        <div class="row fitem">
            <div class="col-12">
                <input
                    type="text"
                    class="form-control w-100 mb-2"
                    id="id_bibliography_{{field}}_surename"
                    data-name="{{field}}-surename"
                    placeholder="{{#str}} field:sure_name, tiny_bibliography {{/str}}"
                >
            </div>

            <div class="col-12">
                <input
                    type="text"
                    class="form-control w-100 mb-2"
                    id="id_bibliography_{{field}}_firstname"
                    data-name="{{field}}-firstname"
                    placeholder="{{#str}} field:first_name, tiny_bibliography {{/str}}"
                >
            </div>

            <div class="col-12">
                <input
                    type="text"
                    class="form-control w-100"
                    id="id_bibliography_{{field}}_middlename"
                    data-name="{{field}}-middlename"
                    placeholder="{{#str}} field:middle_name, tiny_bibliography {{/str}}"
                >
            </div>
        </div>
        <hr>
        <div class="row fitem">
            <div class="col d-flex justify-content-between">
                <button class="btn btn-outline-secondary" id="id-cancel-custom-{{field}}" data-field="{{field}}" data-action="cancel-custom-bibliography-author">
                    <span>{{#str}} button:cancel, tiny_bibliography {{/str}}</span>
                </button>
                <button class="btn btn-primary" id="id-ok-custom-{{field}}" data-field="{{field}}" data-action="ok-custom-bibliography-author">
                    <span>{{#str}} button:ok, tiny_bibliography {{/str}}</span>
                </button>
            </div>
        </div>
    </div>
</div>
{{/show}}