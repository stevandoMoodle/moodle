{{!
    @template tiny_bibliography/styles/ieee/website

    Display a generated bibliography of website source.

    Example context (json):
    {
        "updateIndex": 1,
        "allData": [
            {
                "keyValuePair": "{key: value}",
                "author": "L. Name",
                "pageTitle": "Page title",
                "websiteTitle": "Website title",
                "webAddress": "www.moodle.org",
                "monthAccessed": "January",
                "dateAccessed": "10",
                "yearAccessed": "2024"
            }
        ]
    }
}}

<span class="hide-ori-data ori-author">
    {{allData.keyValuePair}}
</span>
<span class="d-flex mb-0">
    <span class="citation-index-{{updateIndex}}">[{{updateIndex}}]</span>
    <span class="ml-2">
        {{allData.author}}.
        "{{allData.pageTitle}}."
        {{allData.websiteTitle}}.
        {{allData.webAddress}} (accessed {{allData.monthAccessed}}. {{allData.dateAccessed}}, {{allData.yearAccessed}}).
    </span>
</span>
