{{!
    @template tiny_bibliography/styles/ieee/book

    Display a generated bibliography of book source.

    Example context (json):
    {
        "updateIndex": 1,
        "allData": [
            {
                "keyValuePair": {"style": "ieee", "source": "book", ...},
                "author": "L. Name",
                "chapterTitle": "Chapter title",
                "publishedTitle": "Published title",
                "volume": "I",
                "edition": "2nd Edition",
                "city": "Perth",
                "state": "Only for U.S.",
                "country": "Australia",
                "publisher": "IEEE",
                "translatedTo": "English",
                "year": "2024",
                "chapter": "1",
                "section": "1",
                "pages": "1-5"
            }
        ]
    }
}}
<span class="hide-ori-data ori-author">
    {{allData.keyValuePair}}
</span>
<span class="d-flex mb-0">
    <span class="citation-index-{{updateIndex}}">[{{updateIndex}}]</span>
    <span class="ml-2">
        {{allData.author}},
        {{#allData.chapterTitle}}"{{allData.chapterTitle}},"{{/allData.chapterTitle}}
        {{#allData.chapterTitle}}in {{/allData.chapterTitle}}<i>{{allData.publishedTitle}}</i>,
        {{#allData.volume}}vol. {{allData.volume}},{{/allData.volume}}
        {{#allData.edition}}{{allData.edition}},{{/allData.edition}}
        {{allData.city}},
        {{#allData.state}}{{allData.state}},{{/allData.state}}
        {{allData.country}}: {{allData.publisher}} (in {{allData.translatedTo}}),
        {{allData.year}},
        {{#allData.chapter}}ch. {{allData.chapter}},{{/allData.chapter}}
        {{#allData.section}}sec. {{allData.section}},{{/allData.section}}
        {{#allData.pages}}pp. {{allData.pages}}{{/allData.pages}}
    </span>
</span>
