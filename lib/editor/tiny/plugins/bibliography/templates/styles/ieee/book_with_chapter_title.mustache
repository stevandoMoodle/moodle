{{!
    @template tiny_bibliography/styles/ieee/book_with_chapter_title

    Display a generated bibliography of book with chapter title source.

    Example context (json):
    {
        "updateIndex": 1,
        "allData": [
            {
                "keyValuePair": {"style": "ieee", "source": "book", ...},
                "author": "L. Name",
                "chapterTitle": "Chapter title",
                "publishedTitle": "Published title",
                "edition": "2nd Edition",
                "city": "Perth",
                "country": "Australia",
                "publisher": "IEEE",
                "year": "2024",
                "chapter": "1",
                "section": "1",
                "pages": "1-5"
            }
        ]
    }
}}

<span class="hide-ori-data ori-author">
    {{allData.keyValuePair}}
</span>
<span class="d-flex mb-0">
    <span class="citation-index-{{updateIndex}}">[{{updateIndex}}]</span>
    <span class="ml-2">
        {{allData.author}},
        "{{allData.chapterTitle}}," in <i>{{allData.publishedTitle}}</i>,
        {{allData.edition}},
        {{allData.city}},
        {{allData.country}}: {{allData.publisher}},
        {{allData.year}},
        {{#allData.chapter}}ch. {{allData.chapter}},{{/allData.chapter}}
        {{#allData.section}}sec. {{allData.section}},{{/allData.section}}
        pp. {{allData.pages}}
    </span>
</span>
