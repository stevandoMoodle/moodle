{{!
    @template tiny_bibliography/footer/insert_bibliography_footer

    Insert bibliography footer template.

    Example context (json):
    {
        "elementid": "id",
        "isInsertThumbnail": false,
        "showDropzone": true,
        "showFilePicker": true
    }

}}
<div class="row">
    <div class="col-md-6 align-items-center p-0">
        <div class="checkbox {{^isInsertBibliography}}d-none{{/isInsertBibliography}}" id="show-all-field-container">
            <input type="checkbox" id="id_other_fields" data-action="show-other-fields">
            <label for="id_other_fields">
                {{#str}} label:allfields, tiny_bibliography {{/str}}
            </label>
        </div>
    </div>
    <div class="col-md-6 text-right md-0 p-0" id="id-button-container">
        <button type="button" class="btn btn-secondary" data-action="cancel">{{#str}} cancel, moodle {{/str}}</button>
        <button class="btn btn-primary {{^isInsertBibliography}}d-none{{/isInsertBibliography}}" id="generate-bibliography-list" data-action="generate-list">
            {{> tiny_bibliography/generate_label }}
        </button>
    </div>
</div>
