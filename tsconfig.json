{
  "extends": "./tsconfig.aliases.json", // Added to extend the generated aliases.
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "types": ["node", "mocha"],
    "lib": ["DOM", "ES2020"],
    "jsx": "react",
    "baseUrl": ".",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },

  "include": [
    "public/**/react/src/**/*",
    "public/**/tests/react/**/*"
  ]
}
