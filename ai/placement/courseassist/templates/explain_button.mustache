{{!
    @template aiplacement_courseassist/explain_button

    Template to display explain button for the course assist.

    Context variables required for this template:
    * none

    Example context (json):
    {
    }
}}
<div class="course-assist-controls pt-3 pb-3">
    <button class="btn btn-outline-secondary ai-action"
            aria-controls="ai-drawer"
            type="button"
            data-action="explain"
            data-toggle="tooltip"
            data-html="true"
            title="{{#str}} explain_tooltips, aiplacement_courseassist {{/str}}"
    >
        <span class="ai-course-assist-sparkles-icon">
            {{#pix}} sparkles, aiplacement_courseassist {{/pix}}
        </span>
        <span class="ai-course-assist-sparkles-icon white">
            {{#pix}} sparkles-white, aiplacement_courseassist {{/pix}}
        </span>
        {{#str}} explain, aiplacement_courseassist {{/str}}
    </button>
</div>
