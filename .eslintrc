{
  "plugins": [
    "jsdoc"
  ],
  "parser": "espree",
  "parserOptions": {
    "sourceType": "module",
    "ecmaVersion": 2022
  },
  "extends": [
    "eslint:recommended"
  ],
  "env": {
    "browser": true,
    "es2020": true
  },
  "globals": {
    "M": true,
    "Y": true
  },
  "reportUnusedDisableDirectives": true,
  "rules": {
    "comma-dangle": "off",
    "no-console": "error",
    "no-empty": "warn",
    "no-extra-parens": "off",
    "no-prototype-builtins": "off",
    "no-unreachable": "warn",
    "array-callback-return": "warn",
    "block-scoped-var": "warn",
    "complexity": "warn",
    "consistent-return": "warn",
    "curly": "error",
    "dot-notation": "warn",
    "no-alert": "warn",
    "no-caller": "error",
    "no-div-regex": "error",
    "no-empty-function": "warn",
    "no-eq-null": "error",
    "no-eval": "error",
    "no-extend-native": "error",
    "no-extra-bind": "warn",
    "no-floating-decimal": "warn",
    "no-global-assign": "warn",
    "no-implied-eval": "error",
    "no-invalid-this": "error",
    "no-iterator": "error",
    "no-labels": "error",
    "no-loop-func": "error",
    "no-multi-spaces": "warn",
    "no-multi-str": "error",
    "no-new-func": "error",
    "no-new-wrappers": "error",
    "no-octal-escape": "error",
    "no-proto": "error",
    "no-redeclare": "warn",
    "no-restricted-globals": [
      "error",
      {
        "name": "Notification"
      }
    ],
    "no-return-assign": "error",
    "no-script-url": "error",
    "no-self-compare": "error",
    "no-sequences": "warn",
    "no-throw-literal": "warn",
    "no-unmodified-loop-condition": "error",
    "no-unused-expressions": "error",
    "no-useless-call": "warn",
    "no-useless-escape": "warn",
    "wrap-iife": [
      "error",
      "any"
    ],
    "no-undef-init": "error",
    "array-bracket-spacing": "warn",
    "block-spacing": "warn",
    "brace-style": [
      "warn",
      "1tbs"
    ],
    "camelcase": "warn",
    "capitalized-comments": [
      "warn",
      "always",
      {
        "ignoreConsecutiveComments": true
      }
    ],
    "comma-spacing": [
      "warn",
      {
        "before": false,
        "after": true
      }
    ],
    "comma-style": [
      "warn",
      "last"
    ],
    "computed-property-spacing": "error",
    "consistent-this": "off",
    "eol-last": "off",
    "func-call-spacing": [
      "warn",
      "never"
    ],
    "func-names": "off",
    "func-style": "off",
    "indent": [
      "off",
      4,
      {
        "SwitchCase": 1
      }
    ],
    "key-spacing": [
      "warn",
      {
        "beforeColon": false,
        "afterColon": true,
        "mode": "minimum"
      }
    ],
    "keyword-spacing": "warn",
    "linebreak-style": [
      "error",
      "unix"
    ],
    "lines-around-comment": "off",
    "max-len": [
      "error",
      132
    ],
    "max-lines": "off",
    "max-depth": "warn",
    "max-nested-callbacks": [
      "warn",
      5
    ],
    "max-params": "off",
    "max-statements": "off",
    "max-statements-per-line": [
      "warn",
      {
        "max": 2
      }
    ],
    "new-cap": [
      "warn",
      {
        "properties": false
      }
    ],
    "new-parens": "warn",
    "newline-per-chained-call": "off",
    "no-array-constructor": "off",
    "no-bitwise": "error",
    "no-continue": "off",
    "no-inline-comments": "off",
    "no-lonely-if": "off",
    "no-mixed-operators": "off",
    "no-multiple-empty-lines": "warn",
    "no-negated-condition": "off",
    "no-nested-ternary": "warn",
    "no-new-object": "off",
    "no-plusplus": "off",
    "no-tabs": "error",
    "no-ternary": "off",
    "no-trailing-spaces": "error",
    "no-underscore-dangle": "off",
    "no-unneeded-ternary": "off",
    "no-whitespace-before-property": "warn",
    "object-curly-newline": "off",
    "object-curly-spacing": "warn",
    "object-property-newline": "off",
    "one-var": "off",
    "one-var-declaration-per-line": [
      "warn",
      "initializations"
    ],
    "operator-assignment": "off",
    "operator-linebreak": "off",
    "padded-blocks": "off",
    "quote-props": [
      "warn",
      "as-needed",
      {
        "unnecessary": false,
        "keywords": true,
        "numbers": true
      }
    ],
    "quotes": "off",
    "semi": "error",
    "semi-spacing": [
      "warn",
      {
        "before": false,
        "after": true
      }
    ],
    "sort-vars": "off",
    "space-before-blocks": "warn",
    "space-before-function-paren": [
      "warn",
      "never"
    ],
    "space-in-parens": "warn",
    "space-infix-ops": "warn",
    "space-unary-ops": "warn",
    "spaced-comment": "warn",
    "unicode-bom": "error",
    "wrap-regex": "off",
    "no-restricted-properties": [
      "warn",
      {
        "object": "M",
        "property": "str",
        "message": "Use \"core/str\" module or M.util.get_string()"
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/yui/src/**/*.js"
      ],
      "plugins": [
        "promise"
      ],
      "extends": [
        "plugin:promise/recommended"
      ],
      "parserOptions": {
        "sourceType": "script"
      },
      "env": {
        "es2020": false
      },
      "rules": {
        "promise/always-return": "warn",
        "promise/no-return-wrap": "warn",
        "promise/param-names": "warn",
        "promise/catch-or-return": [
          "warn",
          {
            "terminationMethod": [
              "catch",
              "fail",
              "always"
            ],
            "allowFinally": true
          }
        ],
        "promise/no-native": "warn",
        "promise/avoid-new": "warn",
        "no-undef": "off",
        "no-unused-vars": "off",
        "no-unused-expressions": "off",
        "jsdoc/check-access": "off",
        "jsdoc/check-alignment": "off",
        "jsdoc/check-param-names": "off",
        "jsdoc/check-property-names": "off",
        "jsdoc/empty-tags": "off",
        "jsdoc/implements-on-classes": "off",
        "jsdoc/multiline-blocks": "off",
        "jsdoc/require-jsdoc": "off",
        "jsdoc/require-param": "off",
        "jsdoc/require-param-name": "off",
        "jsdoc/require-param-type": "off",
        "jsdoc/require-property": "off",
        "jsdoc/require-property-name": "off",
        "jsdoc/require-property-type": "off"
      }
    },
    {
      "files": [
        "**/amd/src/*.js",
        "**/amd/src/**/*.js",
        "Gruntfile.js",
        ".grunt/*.js",
        ".grunt/tasks/*.js",
        "jsdoc.conf.js"
      ],
      "plugins": [
        "promise",
        "@babel"
      ],
      "extends": [
        "plugin:promise/recommended"
      ],
      "parser": "@babel/eslint-parser",
      "parserOptions": {
        "requireConfigFile": false
      },
      "env": {
        "amd": true
      },
      "rules": {
        "no-implicit-globals": "error",
        "new-cap": "off",
        "no-invalid-this": "off",
        "object-curly-spacing": "off",
        "quotes": "off",
        "semi": "off",
        "no-unused-expressions": "off",
        "@babel/new-cap": [
          "warn",
          {
            "properties": false
          }
        ],
        "@babel/no-invalid-this": "off",
        "@babel/object-curly-spacing": "warn",
        "@babel/semi": "error",
        "@babel/no-unused-expressions": "error",
        "no-unused-vars": [
          "error",
          {
            "caughtErrors": "none"
          }
        ],
        "promise/always-return": "warn",
        "promise/no-return-wrap": "warn",
        "promise/param-names": "warn",
        "promise/catch-or-return": [
          "warn",
          {
            "terminationMethod": [
              "catch",
              "fail",
              "always"
            ],
            "allowFinally": true
          }
        ],
        "promise/no-native": "off",
        "promise/avoid-new": "off",
        "jsdoc/check-access": "error",
        "jsdoc/check-alignment": 1,
        "jsdoc/check-param-names": "error",
        "jsdoc/check-property-names": "error",
        "jsdoc/empty-tags": "error",
        "jsdoc/implements-on-classes": "error",
        "jsdoc/multiline-blocks": "error",
        "jsdoc/require-jsdoc": "error",
        "jsdoc/require-param": "error",
        "jsdoc/require-param-name": "error",
        "jsdoc/require-param-type": "error",
        "jsdoc/require-property": "error",
        "jsdoc/require-property-name": "error",
        "jsdoc/require-property-type": "error"
      }
    },
    {
      files: ["**/*.ts", "**/*.tsx"],
      parser: '@typescript-eslint/parser',
      parserOptions: {
        sourceType: 'module',
        ecmaFeatures: {
            jsx: true
        }
      },
      rules: {
        // promise/no-native crashes on TypeScript ASTs (same reason it is
        // disabled for AMD files above). Native Promises are standard in TS.
        'promise/no-native': 'off',
        'promise/avoid-new': 'off',
      }
    }
  ],
  "ignorePatterns": [
    "!/.grunt",
    "*/**/yui/src/*/meta/",
    "*/**/build/",
    "node_modules/",
    "vendor/",
    "public/admin/tool/componentlibrary/amd/src/lunr.js",
    "public/admin/tool/messageinbound/roundcube/",
    "public/admin/tool/mfa/factor/totp/extlib/OTPHP/",
    "public/admin/tool/mfa/factor/totp/extlib/ParagonIE/ConstantTime/",
    "public/admin/tool/policy/amd/src/jquery-eu-cookie-law-popup.js",
    "public/enrol/lti/ims-blti/",
    "public/filter/algebra/AlgParser.pm",
    "public/filter/codehighlighter/amd/src/prism.js",
    "public/h5p/h5plib/v127/joubel/core/",
    "public/h5p/h5plib/v127/joubel/editor/",
    "public/lib/editor/tiny/plugins/html/amd/src/codemirror-lazy.js",
    "public/lib/editor/tiny/plugins/html/amd/src/beautify/",
    "public/lib/editor/tiny/plugins/recordrtc/amd/src/lame.all.js",
    "public/lib/editor/tiny/js/tinymce/",
    "public/lib/adodb/",
    "public/lib/behat/axe/",
    "public/lib/composer/pcre/",
    "public/lib/bennu/",
    "public/lib/evalmath/",
    "public/lib/phpspreadsheet/phpspreadsheet/",
    "public/lib/phpspreadsheet/markbaker/complex/",
    "public/lib/phpspreadsheet/markbaker/matrix/",
    "public/lib/google/",
    "public/lib/htmlpurifier/",
    "public/lib/minify/matthiasmullie-minify/",
    "public/lib/minify/matthiasmullie-pathconverter/",
    "public/lib/pear/HTML/Common.php",
    "public/lib/pear/HTML/QuickForm.php",
    "public/lib/pear/HTML/QuickForm/",
    "public/lib/pear/PEAR.php",
    "public/lib/phpmailer/",
    "public/lib/simplepie/",
    "public/lib/tcpdf/",
    "public/lib/yuilib/",
    "public/lib/yuilib/gallery/",
    "public/lib/jquery/",
    "public/lib/html2text/",
    "public/lib/markdown/",
    "public/lib/xhprof/",
    "public/lib/requirejs/",
    "public/lib/amd/src/loglevel.js",
    "public/lib/mustache/",
    "public/lib/amd/src/mustache.js",
    "public/lib/graphlib.php",
    "public/lib/php-css-parser/",
    "public/lib/rtlcss/",
    "public/lib/scssphp/",
    "public/lib/openspout/",
    "public/lib/amd/src/chartjs-lazy.js",
    "public/lib/maxmind/GeoIp2/",
    "public/lib/maxmind/MaxMind/",
    "public/lib/ltiprovider/",
    "public/lib/lti1p3/",
    "public/lib/amd/src/truncate.js",
    "public/lib/fonts/",
    "public/lib/amd/src/adapter.js",
    "public/lib/validateurlsyntax.php",
    "public/lib/amd/src/popper.js",
    "public/lib/amd/src/popper2.js",
    "public/lib/geopattern-php/",
    "public/lib/php-jwt/",
    "public/lib/polyfills/",
    "public/lib/emoji-data/",
    "public/lib/plist/",
    "public/lib/zipstream/",
    "public/lib/psr/container/",
    "public/lib/psr/clock/",
    "public/lib/psr/http-client/",
    "public/lib/psr/http-factory/",
    "public/lib/psr/http-message/",
    "public/lib/psr/http-server-handler/",
    "public/lib/psr/http-server-middleware/",
    "public/lib/psr/event-dispatcher/",
    "public/lib/psr/log/",
    "public/lib/psr/simple-cache/",
    "public/lib/phpxmlrpc/",
    "public/lib/guzzlehttp/guzzle/",
    "public/lib/guzzlehttp/promises/",
    "public/lib/ralouphie/getallheaders/",
    "public/lib/guzzlehttp/psr7/",
    "public/lib/symfony/deprecation-contracts/",
    "public/lib/guzzlehttp/kevinrob/guzzlecache/",
    "public/lib/webauthn/",
    "public/lib/aws-sdk/",
    "public/lib/jmespath/",
    "public/lib/laravel/serializable-closure/",
    "public/lib/php-di/php-di/",
    "public/lib/php-di/invoker/",
    "public/lib/slim/slim/",
    "public/lib/nikic/fast-route/",
    "public/lib/spatie/php-cloneable/",
    "public/lib/giggsey/libphonenumber-for-php-lite/",
    "public/lib/monolog/",
    "public/lib/psr/cache/",
    "public/lib/google2/",
    "public/lib/google2-auth/",
    "public/lib/google2-service/",
    "public/media/player/videojs/amd/src/video-lazy.js",
    "public/media/player/videojs/amd/src/Youtube-lazy.js",
    "public/media/player/videojs/videojs/",
    "public/media/player/videojs/amd/src/local/ogv/ogv.js",
    "public/media/player/videojs/ogvjs/",
    "public/media/player/videojs/amd/src/videojs-ogvjs-lazy.js",
    "public/mod/assign/feedback/editpdf/fpdi/",
    "public/repository/s3/S3.php",
    "public/theme/boost/scss/bootstrap/",
    "public/theme/boost/amd/src/bootstrap/",
    "public/theme/boost/amd/src/index.js",
    "public/theme/boost/scss/fontawesome/"
  ]
}
